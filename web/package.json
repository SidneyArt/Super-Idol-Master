{
  "name": "super-idol-master-local-web",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build && node scripts/check-bundle.mjs",
    "start": "node scripts/run-vinext.mjs start",
    "local": "node scripts/start-local.mjs",
    "python:sync": "uv sync --locked --project server/pipeline",
    "python:check": "uv run --locked --project server/pipeline python -c \"import PIL, requests; print('Python pipeline ready')\"",
    "backend": "npm run python:sync && node server/index.mjs",
    "agent:verify": "node scripts/verify-stepfun-pi.mjs",
    "test": "npm run test:node && npm run test:python && npm run build",
    "test:node": "node scripts/check-architecture.mjs && node --test server/*.test.mjs",
    "test:e2e": "playwright test",
    "test:python": "uv run --locked --project server/pipeline python -m unittest discover -s server/pipeline -p \"test_*.py\"",
    "lint": "node scripts/check-architecture.mjs && eslint . --ignore-pattern dist --ignore-pattern .next",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "lint:bundle": "node scripts/check-bundle.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.46.0",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.113.0"
  },
  "overrides": {
    "ws": "8.21.0",
    "sharp": "0.35.0",
    "postcss": "8.5.14",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
